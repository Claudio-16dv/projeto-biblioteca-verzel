# Credenciais do banco PostgreSQL (usadas pelo docker-compose)
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=biblioteca
POSTGRES_DB=biblioteca

# Portas expostas no host. Ajuste se ja estiverem ocupadas na sua maquina.
# CORS_ORIGIN e NEXT_PUBLIC_API_URL sao derivados destas no docker-compose.yml.
DB_PORT=5432
API_PORT=3001
WEB_PORT=3000

# Apenas para rodar o backend fora do Docker (dentro do compose o host e "db").
# DATABASE_URL=postgresql://biblioteca:biblioteca@localhost:5432/biblioteca
